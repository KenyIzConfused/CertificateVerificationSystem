rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /Admin/{adminId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && get(/databases/$(database)/documents/Admin/$(request.auth.uid)).data.role == 'system_admin';
      allow delete: if request.auth != null && get(/databases/$(database)/documents/Admin/$(request.auth.uid)).data.role == 'system_admin';
    }

    match /Events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /Events/{eventId}/Attendees/{attendeeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /RegisteredStudents/{studentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
