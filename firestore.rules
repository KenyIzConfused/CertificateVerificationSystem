rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin collection - users can read/write their own admin document
    match /Admin/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Admin session tracking - each admin manages their own session doc
    match /adminSessions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Invite codes - created and validated only by Cloud Functions
    // (Admin SDK). No client read/write access; codes gate admin signup.
    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    // Events collection - admins can CRUD their own events
    // Single-document reads stay public; list queries allowed for eventCode lookup
    match /Events/{eventId} {
      allow get: if true;
      allow list: if true;
      // Owner-only modification: resource.data is the stored document, so a
      // logged-in user cannot take over an event by forging adminId in the payload
      allow update, delete: if request.auth != null &&
        resource.data.adminId == request.auth.uid;
      // New events must be created by - and assigned to - the calling admin
      allow create: if request.auth != null &&
        request.resource.data.adminId == request.auth.uid;

      // Attendees subcollection - single docs readable for verification,
      // but the collection cannot be listed anonymously
      match /Attendees/{attendeeId} {
        allow get: if true;
        allow list: if request.auth != null;
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/Events/$(eventId)).data.adminId == request.auth.uid;
      }

      // Certificate formats (docx templates) per event - editable by the event owner
      match /certificateFormats/{formatId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/Events/$(eventId)).data.adminId == request.auth.uid;
      }
    }
  }
}