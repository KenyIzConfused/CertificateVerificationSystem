rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin collection - users can read/write their own admin document
    match /Admin/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Admin session tracking - each admin manages their own session doc
    match /adminSessions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Invite codes - created and validated only by Cloud Functions
    // (Admin SDK). No client read/write access.
    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    // Events collection - fully open: anyone can read, create, update, delete
    match /Events/{eventId} {
      allow get, list: if true;
      allow create, update, delete: if true;

      // Attendees subcollection - fully open
      match /Attendees/{attendeeId} {
        allow get, list: if true;
        allow create, update, delete: if true;
      }

      // Certificate formats - fully open
      match /certificateFormats/{formatId} {
        allow read, write: if true;
      }
    }
  }
}
