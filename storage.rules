rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Uploaded certificate template docx files per event - writable by the event owner
    match /certificate-format-templates/{eventId}/{allPaths=**} {
      allow read, write: if request.auth != null &&
        get(/databases/(default)/documents/Events/$(eventId)).data.adminId == request.auth.uid;
    }
  }
}
